{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-memory-architecture/recovery-eval-v0.1.schema.json",
  "title": "Authoritative-State Recovery Evaluation V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "description", "tasks"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "documents", "governance", "ground_truth"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "question": {"type": "string", "minLength": 1},
        "documents": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"type": "string"}
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "authority_path", "non_authoritative_paths"],
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "authority_path": {"type": "string", "minLength": 1},
            "non_authoritative_paths": {"$ref": "#/$defs/pathArray"}
          }
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current_state", "authority_path", "stale_or_non_authoritative_paths"],
          "properties": {
            "current_state": {"type": "string", "minLength": 1},
            "authority_path": {"type": "string", "minLength": 1},
            "stale_or_non_authoritative_paths": {"$ref": "#/$defs/pathArray"}
          }
        }
      }
    }
  }
}
